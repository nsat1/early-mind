            "description": "Все сессии завершены"
          },
          "401": {
            "description": "Нет действующей сессии",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Not authenticated"
                }
              }
            }
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/account": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Данные аккаунта",
        "description": "Email аккаунта для экрана родителя. Нужен вход. Каждый запрос продлевает сессию на 30 дней, но не дальше 90 дней от входа.",
        "operationId": "get_account",
        "responses": {
          "200": {
            "description": "Аккаунт",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "401": {
            "description": "Нет действующей сессии, cookie удаляется",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Not authenticated"
                }
              }
            }
