{
  "openapi": "3.1.0",
  "info": {
    "title": "Early Mind API",
    "summary": "API платформы обучения Early Mind",
    "description": "Ошибки возвращаются в формате Problem Details (RFC 9457) с типом `application/problem+json`.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Процесс API работает",
        "description": "Отвечает, пока процесс запущен. БД не проверяется.",
        "operationId": "check_health",
        "responses": {
          "200": {
            "description": "Процесс работает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "API готов принимать запросы",
        "description": "Проверяет БД и хранилище сессий Redis, отвечает 503, если одно из них недоступно.",
        "operationId": "check_readiness",
        "responses": {
          "200": {
            "description": "API готов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "API не готов: база данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alphabets/{alphabet_id}/letters": {
      "get": {
        "tags": [
          "alphabet"
        ],
        "summary": "Список букв алфавита",
        "description": "Буквы в порядке позиции в алфавите. Фильтр `kind` оставляет буквы одного вида; если таких нет — пустой список.",
        "operationId": "list_letters",
        "parameters": [
          {
            "name": "alphabet_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 10,
              "pattern": "^[a-z]+$",
              "description": "Код алфавита, пример - ru (код языка по ISO 639-1)",
              "examples": [
                "ru"
              ],
              "title": "Alphabet Id"
            },
            "description": "Код алфавита, пример - ru (код языка по ISO 639-1)"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/LetterKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Вид букв: `vowel` — гласные, `consonant` — согласные, `sign` — знаки. Без фильтра — все буквы",
              "title": "Kind"
            },
            "description": "Вид букв: `vowel` — гласные, `consonant` — согласные, `sign` — знаки. Без фильтра — все буквы"
          }
        ],
        "responses": {
          "200": {
            "description": "Буквы алфавита",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LetterSummary"
                  },
                  "title": "Response List Letters"
                }
              }
            }
          },
          "404": {
            "description": "Алфавит не найден",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "Alphabet not found"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "База данных недоступна",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alphabets/{alphabet_id}/letters/{code}": {
      "get": {
        "tags": [
          "alphabet"
        ],
        "summary": "Буква со словами-примерами",
        "description": "Буква по коду вместе со словами-примерами в порядке показа.",
        "operationId": "get_letter",
        "parameters": [
          {
            "name": "alphabet_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 10,
              "pattern": "^[a-z]+$",
              "description": "Код алфавита, пример - ru (код языка по ISO 639-1)",
              "examples": [
                "ru"
              ],
              "title": "Alphabet Id"
            },
            "description": "Код алфавита, пример - ru (код языка по ISO 639-1)"
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^[a-z]+$",
              "description": "Код буквы латиницей, например `a` или `zh`",
              "examples": [
                "m"
              ],
              "title": "Code"
            },
            "description": "Код буквы латиницей, например `a` или `zh`"
          }
        ],
        "responses": {
          "200": {
            "description": "Буква",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LetterDetail"
                }
              }
            }
          },
          "404": {
            "description": "Алфавит или буква не найдены",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "Alphabet or letter not found"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "База данных недоступна",
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/events": {
      "post": {
        "tags": [
          "analytics"
        ],
        "summary": "Принять события аналитики",
        "description": "Сохраняет обезличенные события. Время получения фиксируется с точностью до часа.",
        "operationId": "record_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AppOpened"
                    },
                    {
                      "$ref": "#/components/schemas/SessionFinished"
                    },
                    {
                      "$ref": "#/components/schemas/AnswerGiven"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "name",
                    "mapping": {
                      "app_opened": "#/components/schemas/AppOpened",
                      "session_finished": "#/components/schemas/SessionFinished",
                      "answer_given": "#/components/schemas/AnswerGiven"
                    }
                  }
                },
                "type": "array",
                "maxItems": 50,
                "minItems": 1,
                "title": "Events",
                "description": "Пачка от 1 до 50 событий по каталогу аналитики. Тип содержимого — `application/json`, в том числе при отправке через `navigator.sendBeacon`."
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "События приняты"
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "База данных недоступна",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Зарегистрировать аккаунт родителя",
        "description": "Создаёт неподтверждённый аккаунт и отправляет письмо со ссылкой подтверждения. Если email уже зарегистрирован, ответ тот же, а письмо сообщает, что аккаунт уже есть: по ответу нельзя узнать, зарегистрирован ли email.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Запрос принят, письмо будет отправлено"
          },
          "422": {
            "description": "Параметры запроса не прошли проверку или пароль не по правилам",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email-verification": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Подтвердить email",
        "description": "Подтверждает email по токену из ссылки в письме. Ссылка действует 24 часа и только один раз.",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Email подтверждён"
          },
          "400": {
            "description": "Ссылка устарела, уже использована или аккаунт удалён",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "Invalid or expired link"
                }
              }
            }
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email-verification/resend": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Отправить письмо подтверждения ещё раз",
        "description": "Если аккаунт есть и email не подтверждён, отправляет письмо с новой ссылкой, прежняя перестаёт работать. Не больше 3 писем в час на аккаунт. Ответ одинаковый в любом случае.",
        "operationId": "resend_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationResend"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Запрос принят"
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Войти",
        "description": "Проверяет email и пароль и ставит cookie сессии. Каждый вход создаёт новую сессию. О неподтверждённом email ответ сообщает только после верного пароля.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Вход выполнен",
            "headers": {
              "Set-Cookie": {
                "description": "`__Host-session=<идентификатор>; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=7776000`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Неверный email или пароль",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Invalid email or password"
                }
              }
            }
          },
          "403": {
            "description": "Пароль верный, но email не подтверждён",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Forbidden",
                  "status": 403,
                  "detail": "Email not verified"
                }
              }
            }
          },
          "429": {
            "description": "Вход приостановлен после 5 неудачных попыток за 15 минут",
            "headers": {
              "Retry-After": {
                "description": "Через сколько секунд можно повторить вход",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Too Many Requests",
                  "status": 429,
                  "detail": "Too many login attempts"
                }
              }
            }
          },
          "422": {
            "description": "Параметры запроса не прошли проверку",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Request parameters are invalid",
                  "errors": [
                    {
                      "in": "path",
                      "name": "alphabet_id",
                      "code": "string_pattern_mismatch",
                      "detail": "String should match pattern '^[a-z]+$'"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Выйти",
        "description": "Завершает текущую сессию и удаляет cookie. Если сессии уже нет, ответ тот же.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Сессия завершена"
          },
          "503": {
            "description": "База данных или хранилище сессий недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Database unavailable"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Выйти на всех устройствах",
        "description": "Завершает все сессии аккаунта, включая текущую, и удаляет cookie.",
        "operationId": "logout_all",
        "responses": {
