Table alphabets {
  alphabet_id varchar(10) [pk]
}

Table letters {
  letter_id integer [pk, increment]
  alphabet_id varchar(10) [not null]
  code varchar(20) [not null]
  symbol varchar(1) [not null]
  kind varchar(9) [not null]
  position smallint [not null]
  sound varchar(111)
  image varchar(111)

  indexes {
    (alphabet_id, code) [unique, name: 'uq_letters_alphabet_id_code']
    (alphabet_id, position) [unique, name: 'uq_letters_alphabet_id_position']
  }
}

Table words {
  word_id integer [pk, increment]
  letter_id integer [not null]
  example varchar(50) [not null]
  position smallint [not null]
  image varchar(111)
  sound varchar(111)

  indexes {
    (letter_id, position) [unique, name: 'uq_words_letter_id_position']
  }
}

Table analytics_events {
  analytics_event_id bigint [pk, increment]
  name varchar(20) [not null]
  schema_version smallint [not null]
  app_version varchar(20) [not null]
  properties jsonb [not null]
  received_at timestamptz [not null, default: `date_trunc('hour', now())`]

  indexes {
    (name, received_at) [name: 'ix_analytics_events_name_received_at']
  }
}

Table accounts {
  account_id uuid [pk, default: `uuidv7()`]
  email varchar(254) [not null, unique]
  password_hash varchar(128) [not null]
  email_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table consents {
  account_id uuid [not null]
  policy_version varchar(20) [not null]
  accepted_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, policy_version) [pk, name: 'pk_consents']
  }
}

Ref fk_letters_alphabet_id_alphabets: letters.alphabet_id > alphabets.alphabet_id [delete: cascade]
Ref fk_words_letter_id_letters: words.letter_id > letters.letter_id [delete: cascade]
Ref fk_consents_account_id_accounts: consents.account_id > accounts.account_id [delete: cascade]
